# ------------------------------------------------------------------
# Example environment for the skills in this repo.
# Copy to `.env` (which is git-ignored) and fill in real values.
# NEVER commit the filled-in .env — only this template is tracked.
# ------------------------------------------------------------------

# --- Required by the firecrawl-* skills (firecrawl CLI) ---
FIRECRAWL_API_KEY=

# --- Required by the valyu-best-practices skill ---
VALYU_API_KEY=
# Optional; only set to override the default Valyu endpoint
# VALYU_API_BASE=

# --- Optional: only needed by skill examples that call these providers directly
#     (mostly valyu / agent-style samples). Leave blank unless you use them. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
