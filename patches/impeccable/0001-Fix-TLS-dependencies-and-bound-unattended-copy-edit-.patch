+
+fn validate_worker_root(cwd: &str, env: &Env) -> Result<(), String> {
+    let root = std::fs::canonicalize(cwd).map_err(|e| format!("Invalid worker project: {e}"))?;
+    let home = std::fs::canonicalize(impeccable_context::util::homedir(env)).ok();
+    if root.parent().is_none() || home.as_ref() == Some(&root) {
+        return Err("Choose a project directory, not a filesystem root or your home, for unattended edits.".into());
+    }
+    Ok(())
+}
+
+fn supported_worker_version(text: &str, minimum: (u64, u64, u64)) -> bool {
+    text.split_whitespace().filter_map(|part| {
+        let mut numbers = part.trim_start_matches('v').split(['.', '-']);
+        Some((numbers.next()?.parse::<u64>().ok()?, numbers.next()?.parse::<u64>().ok()?, numbers.next()?.parse::<u64>().ok()?))
+    }).any(|version| version >= minimum)
+}
+
+fn require_worker_version(command: &str, minimum: (u64, u64, u64)) -> Result<(), String> {
+    let output = Command::new(command).arg("--version").stdin(Stdio::null()).output()
+        .map_err(|e| format!("Cannot verify {command} worker permissions: {e}"))?;
+    if output.status.success() && supported_worker_version(&String::from_utf8_lossy(&output.stdout), minimum) {
+        return Ok(());
+    }
+    Err(format!("The bounded worker requires {command} {}.{}.{} or newer. Continue in the parent chat; no unrestricted retry was attempted.", minimum.0, minimum.1, minimum.2))
+}
+
+#[cfg(test)]
+mod worker_permission_tests {
+    use super::*;
+
+    #[test]
+    fn unsupported_worker_versions_fail_closed() {
+        assert!(!supported_worker_version("2.1.220 (Claude Code)", (2, 1, 314)));
+        assert!(supported_worker_version("2.1.314 (Claude Code)", (2, 1, 314)));
+        assert!(supported_worker_version("codex-cli 0.169.0-alpha.11.1", (0, 169, 0)));
+        assert!(!supported_worker_version("unknown", (0, 169, 0)));
+    }
+
+    #[test]
+    fn workers_reject_home_as_project() {
+        let root = std::env::temp_dir();
+        let root = root.to_str().unwrap();
+        let mut env = Env::new();
+        env.insert("HOME".into(), root.into());
+        env.insert("USERPROFILE".into(), root.into());
+        assert!(validate_worker_root(root, &env).is_err());
+    }
+
+    #[test]
+    fn codex_worker_keeps_a_sandbox_without_repeated_prompts() {
+        let args = codex_args("/project", &Env::new(), "/output/result.json");
+        assert!(!args.iter().any(|a| a.contains("dangerously-bypass")));
+        assert!(args.contains(&"default_permissions=\"impeccable_worker\"".to_string()));
+        assert!(args.contains(&"approval_policy=\"never\"".to_string()));
+        assert!(args.contains(&"permissions.impeccable_worker.network.enabled=false".to_string()));
+        let fs = args.iter().find(|a| a.starts_with("permissions.impeccable_worker.filesystem=")).unwrap();
+        assert!(fs.contains(":minimal"));
+        assert!(fs.contains(":workspace_roots"));
+        assert!(!fs.contains(":root"));
+        assert!(fs.contains("**/.env*"));
+        assert!(args.contains(&"--ignore-user-config".to_string()));
+        assert!(args.contains(&"features.hooks=false".to_string()));
+        assert!(args.contains(&"features.plugins=false".to_string()));
+    }
+
+    #[test]
+    fn claude_worker_allows_file_edits_but_has_no_shell_or_connector_tools() {
+        let args = claude_args(&Env::new());
+        assert!(!args.iter().any(|a| a == "bypassPermissions" || a.contains("dangerously")));
+        assert!(args.contains(&"dontAsk".to_string()));
+        assert!(args.contains(&"--safe-mode".to_string()));
+        let tools = args.windows(2).find(|a| a[0] == "--tools").unwrap();
+        assert_eq!(tools[1], "Read,Glob,Grep,Edit,Write");
+        let settings = args.windows(2).find(|a| a[0] == "--settings").unwrap();
+        let settings: Value = serde_json::from_str(&settings[1]).unwrap();
+        assert_eq!(settings["permissions"]["blockReadsOutsideWorkingDirectories"], true);
+        assert_eq!(settings["permissions"]["blockWritesOutsideWorkingDirectories"], true);
+        assert!(settings["permissions"]["deny"].as_array().unwrap().contains(&json!("Read(**/.env*)")));
+    }
 }
 
