+"""Stage this reviewed Windows skill without executing upstream installers."""
+from pathlib import Path
+import hashlib
+import json
+import shutil
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+destination = root / 'local-build' / 'package' / 'impeccable'
+if destination.exists():
+    raise SystemExit('Package already exists; preserve the reviewed copy and use a fresh staging path.')
+source = root / 'dist' / 'agents' / '.agents' / 'skills' / 'impeccable'
+binary = root / 'local-build' / 'artifacts' / 'impeccable.exe'
+if not (source / 'SKILL.md').is_file() or not binary.is_file():
+    raise SystemExit('Build the skill and Windows engine first.')
+shutil.copytree(source, destination)
+for name in ('impeccable', 'impeccable.cmd', 'impeccable.ps1'):
+    text = (root / 'local-build' / 'launchers' / name).read_text(encoding='utf-8')
+    newline = '\r\n' if name.endswith('.cmd') else '\n'
+    (destination / 'scripts' / name).write_text(text, encoding='utf-8', newline=newline)
+engine_dir = destination / 'scripts' / 'bin' / 'windows-x64'
+engine_dir.mkdir(parents=True)
+shutil.copy2(binary, engine_dir / binary.name)
+shutil.copy2(root / 'LICENSE', destination / 'LICENSE')
+shutil.copy2(root / 'local-build' / 'LOCAL-REVIEW.md', destination / 'LOCAL-REVIEW.md')
+source_commit = subprocess.check_output(['git', '-C', str(root), 'rev-parse', 'HEAD'], text=True).strip()
+manifest = {
+    'distribution': 'vince-reviewed-windows-1',
+    'upstream_base': '5261629497162ccdc68618421f29863db2be094a',
+    'source_commit': source_commit,
+    'platform': 'windows-x64',
+    'sha256': hashlib.sha256(binary.read_bytes()).hexdigest(),
+    'worker_mode': 'parent-chat',
+}
+(destination / 'scripts' / 'local-engine.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8')
+skill = destination / 'SKILL.md'
+text = skill.read_text(encoding='utf-8')
+frontmatter_end = text.index('\n---', 3) + len('\n---')
+notice = '\n\nRead [LOCAL-REVIEW.md](LOCAL-REVIEW.md) before the first use. This is a locally patched Windows distribution: use its bundled launcher, retain parent-chat approvals, and never replace it with an npm or upstream engine.\n'
+skill.write_text(text[:frontmatter_end] + notice + text[frontmatter_end:], encoding='utf-8', newline='\n')
+print(json.dumps(manifest, indent=2))
+print(destination)
