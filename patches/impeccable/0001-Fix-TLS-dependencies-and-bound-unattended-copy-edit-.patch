+// Exercise the actual Codex sandbox with synthetic files; no model is called.
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import { spawn } from 'node:child_process';
+import http from 'node:http';
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'impeccable-permissions-'));
+const project = path.join(root, 'project');
+fs.mkdirSync(project);
+fs.writeFileSync(path.join(project, 'allowed.txt'), 'synthetic fixture');
+fs.writeFileSync(path.join(project, '.env.test'), 'SYNTHETIC_SECRET=not-a-real-secret');
+fs.writeFileSync(path.join(root, 'outside.txt'), 'synthetic outside fixture');
+const server = http.createServer((_req, res) => res.end('reachable'));
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+const port = server.address().port;
+const childSource = `
+const fs = require('node:fs');
+const http = require('node:http');
+const results = {};
+results.projectRead = fs.readFileSync('allowed.txt', 'utf8') === 'synthetic fixture';
+fs.writeFileSync('created.txt', 'routine edit');
+results.projectWrite = fs.existsSync('created.txt');
+for (const [key, action] of [
+  ['outsideReadDenied', () => fs.readFileSync(${JSON.stringify(path.join(root, 'outside.txt'))})],
+  ['outsideWriteDenied', () => fs.writeFileSync(${JSON.stringify(path.join(root, 'outside-write.txt'))}, 'bad')],
+  ['secretReadDenied', () => fs.readFileSync('.env.test')]
+]) { try { action(); results[key] = false; } catch { results[key] = true; } }
+const req = http.get('http://127.0.0.1:${port}', () => { results.networkDenied = false; done(); });
+req.setTimeout(3000, () => req.destroy(new Error('blocked or timed out')));
+req.on('error', () => { results.networkDenied = true; done(); });
+let finished = false;
+function done() { if (finished) return; finished = true; console.log(JSON.stringify(results)); process.exit(Object.values(results).every(Boolean) ? 0 : 1); }
+`;
+fs.writeFileSync(path.join(project, 'probe.cjs'), childSource);
+const source = fs.readFileSync(new URL('../crates/live/src/copy_edit_agent.rs', import.meta.url), 'utf8');
+const filesystem = source.match(/r#"(permissions\.impeccable_worker\.filesystem=.*)"#,/)?.[1];
+if (!filesystem) throw new Error('Worker filesystem policy not found');
+const args = ['sandbox', '-C', project, '-P', 'impeccable_worker', '-c', filesystem,
+  '-c', 'permissions.impeccable_worker.network.enabled=false', '--', process.execPath, 'probe.cjs'];
+const child = spawn('codex', args, { stdio: ['ignore', 'pipe', 'pipe'] });
+let out = '', err = '';
+child.stdout.on('data', data => { out += data; });
+child.stderr.on('data', data => { err += data; });
+const timer = setTimeout(() => child.kill(), 45000);
+child.on('error', error => { err += String(error); });
+const code = await new Promise(resolve => child.on('close', resolve));
+clearTimeout(timer);
+server.close();
+console.log(out.trim());
+if (err.trim()) console.error(err.trim());
+console.log('Synthetic fixtures retained at:', root);
+process.exitCode = code === 0 ? 0 : 1;
